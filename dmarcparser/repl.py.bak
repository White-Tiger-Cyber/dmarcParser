import os, shlex
from rich.console import Console
from rich.prompt import Prompt
from . import views, ingest

def _setup_history(client_key: str):
    """Enable readline history (last 50 cmds), per-client file."""
    try:
        import readline  # GNU readline on Linux/macOS
    except Exception:
        return None  # graceful fallback (Windows etc.)
    hist_dir = os.path.expanduser("~/.dmarcParser/history")
    os.makedirs(hist_dir, exist_ok=True)
    hist_file = os.path.join(hist_dir, f"{client_key}.hist")
    try:
        readline.read_history_file(hist_file)
    except FileNotFoundError:
        pass
    readline.set_history_length(50)
    return hist_file

def run_shell(db_path, client_key):
    console = Console()
    hist_file = _setup_history(client_key)

    console.print(f"[bold]dmarcParser REPL[/bold] — client: [cyan]{client_key}[/cyan]  DB: {db_path}")
    console.print("Commands: summary [--days N] | domains [--limit N] [--sort msgs|fails|fail_rate] "
                  "[--days N] [--fail-only] | ingest <path> [--rescan] | export domains <out.csv> "
                  "[--days N] [--fail-only] | help | exit")

    try:
        while True:
            try:
                line = Prompt.ask("dP>")
            except (EOFError, KeyboardInterrupt):
                console.print("")
                break

            if not line.strip():
                continue

            try:
                parts = shlex.split(line)
            except Exception as e:
                console.print(f"[red]Parse error:[/red] {e}")
                continue

            cmd = parts[0].lower()
            if cmd in ("exit", "quit", "q"):
                break

            elif cmd == "help":
                console.print("summary [--days N]\n"
                              "domains [--limit N] [--sort msgs|fails|fail_rate] [--days N] [--fail-only]\n"
                              "ingest <path> [--rescan]\n"
                              "export domains <out.csv> [--days N] [--fail-only]\n"
                              "exit")

            elif cmd == "summary":
                days = None
                if "--days" in parts:
                    try:
                        days = int(parts[parts.index("--days")+1])
                    except Exception:
                        console.print("[red]Usage:[/red] summary --days <N>")
                        continue
                views.summary_view(db_path, days=days)

            elif cmd == "domains":
                limit = 25; sort = "fail_rate"; days = None; fail_only = False
                it = iter(parts[1:])
                for tok in it:
                    if tok == "--limit":
                        limit = int(next(it))
                    elif tok == "--sort":
                        sort = next(it)
                    elif tok == "--days":
                        days = int(next(it))
                    elif tok == "--fail-only":
                        fail_only = True
                    else:
                        console.print(f"[yellow]Unknown option ignored:[/yellow] {tok}")
                views.domains_view(db_path, limit=limit, sort=sort, days=days, fail_only=fail_only)

            elif cmd == "ingest":
                if len(parts) < 2:
                    console.print("[red]Usage:[/red] ingest <path> [--rescan]")
                    continue
                path = os.path.abspath(parts[1])
                rescan = "--rescan" in parts[2:]
                console.print(f"Ingesting: {path}  (rescan={rescan})")
                result = ingest.ingest(path, db_path, client_key, rescan=rescan, dry_run=False)
                console.print(f"[green]Done.[/green] Decisions: {result['summary']}")

            elif cmd == "export":
                # (stub; same as before if you already have export wired)
                console.print("[yellow]Export commands coming next.[/yellow]")

            elif cmd == "ips":
                # defaults
                limit = 50; days = None; failed_only = False; min_fails = 1; sort = "fails"
                it = iter(parts[1:])
                for tok in it:
                    if tok == "--limit":
                        limit = int(next(it))
                    elif tok == "--days":
                        days = int(next(it))
                    elif tok == "--failed-only":
                        failed_only = True
                    elif tok == "--min-fails":
                        min_fails = int(next(it))
                    elif tok == "--sort":
                        sort = next(it)
                    else:
                        console.print(f"[yellow]Unknown option ignored:[/yellow] {tok}")
                views.ips_view(db_path, limit=limit, days=days, failed_only=failed_only, min_fails=min_fails, sort=sort)

            else:
                console.print(f"[red]Unknown command:[/red] {cmd}. Type 'help'.")

    finally:
        # Save history on exit if readline is active
        try:
            import readline
            if hist_file:
                readline.write_history_file(hist_file)
        except Exception:
            pass
